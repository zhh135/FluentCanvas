<views:FCViewBase
    x:Class="FluentCanvas.Views.PptNavigationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:views="clr-namespace:FluentCanvas.Views">
    <views:FCViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </views:FCViewBase.Resources>
    <!--  // PPT 翻页按钮 //  -->
    <Grid>
    <Viewbox
        x:Name="PPTNavigationBottomLeft"
        Height="40"
        Margin="2,0,0,2"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Visibility="Collapsed">
        <Border
            Background="{DynamicResource FloatBarBackground}"
            BorderBrush="{DynamicResource FloatBarBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Opacity="0.4">
            <ikw:SimpleStackPanel Orientation="Horizontal">
                <Border
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    CornerRadius="5 5 0 0"
                    MouseDown="Border_MouseDown"
                    MouseUp="GridPPTControlPrevious_MouseUp">
                    <ui:FontIcon
                        Width="26"
                        Height="26"
                        FontFamily="{StaticResource FluentIconFontFamily}"
                        Foreground="{DynamicResource FloatBarForeground}"
                        Glyph="&#xedd5;" />
                </Border>
                <Border
                    x:Name="PptNavigationBottomBtn"
                    Width="40"
                    Height="38"
                    Background="Transparent"
                    MouseDown="Border_MouseDown"
                    MouseUp="PPTNavigationBtn_Click"
                    Visibility="{Binding IsBottomButtonVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="1" />
                        </Grid.ColumnDefinitions>
                        <Line
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource FloatBarForeground}"
                            StrokeThickness="1"
                            X1="0"
                            X2="0"
                            Y1="0"
                            Y2="25" />
                        <TextBlock
                            x:Name="PptNavigationTextBlockBottom"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="9"
                            Foreground="{DynamicResource FloatBarForeground}"
                            Text="{Binding PositionText}" />
                        <Line
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource FloatBarForeground}"
                            StrokeThickness="1"
                            X1="0"
                            X2="0"
                            Y1="0"
                            Y2="25" />
                    </Grid>
                </Border>
                <Border
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    CornerRadius="0 0 5 5"
                    MouseDown="Border_MouseDown"
                    MouseUp="GridPPTControlNext_MouseUp">
                    <ui:FontIcon
                        Width="26"
                        Height="26"
                        FontFamily="{StaticResource FluentIconFontFamily}"
                        Foreground="{DynamicResource FloatBarForeground}"
                        Glyph="&#xedd6;" />
                </Border>
            </ikw:SimpleStackPanel>
        </Border>
    </Viewbox>
    <Viewbox
        x:Name="PPTNavigationBottomRight"
        Height="40"
        Margin="2,0,0,2"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Visibility="Collapsed">
        <Border
            Background="{DynamicResource FloatBarBackground}"
            BorderBrush="{DynamicResource FloatBarBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Opacity="0.4">
            <ikw:SimpleStackPanel Orientation="Horizontal">
                <Border
                    Width="40"
                    Height="40"
                    Background="Transparent"
