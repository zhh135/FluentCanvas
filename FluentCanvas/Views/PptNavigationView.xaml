                        FontFamily="{StaticResource FluentIconFontFamily}"
                        Foreground="{DynamicResource FloatBarForeground}"
                        Glyph="&#xedd7;" />
                </Border>
                <Border
                    x:Name="PptNavigationSidesBtn"
                    Width="40"
                    Height="38"
                    Background="Transparent"
                    MouseDown="Border_MouseDown"
                    MouseUp="PPTNavigationBtn_Click"
                    Visibility="{Binding IsSideButtonVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <Line
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource FloatBarForeground}"
                            StrokeThickness="1"
                            X1="0"
                            X2="25"
                            Y1="0"
                            Y2="0" />
                        <TextBlock
