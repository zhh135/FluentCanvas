                        FontFamily="{StaticResource FluentIconFontFamily}"
                        Foreground="{DynamicResource FloatBarForeground}"
                        Glyph="&#xedd5;" />
                </Border>
                <Border
                    Width="40"
                    Height="38"
                    Background="Transparent"
                    MouseDown="Border_MouseDown"
                    MouseUp="PPTNavigationBtn_Click"
                    Visibility="{Binding ElementName=PptNavigationBottomBtn, Path=Visibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="1" />
                        </Grid.ColumnDefinitions>
                        <Line
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource FloatBarForeground}"
                            StrokeThickness="1"
                            X1="0"
                            X2="0"
                            Y1="0"
                            Y2="25" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="9"
                            Foreground="{DynamicResource FloatBarForeground}"
                            Text="{Binding PositionText}" />
                        <Line
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource FloatBarForeground}"
                            StrokeThickness="1"
                            X1="0"
                            X2="0"
                            Y1="0"
                            Y2="25" />
                    </Grid>
                </Border>
                <Border
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    CornerRadius="0 0 5 5"
                    MouseDown="Border_MouseDown"
                    MouseUp="GridPPTControlNext_MouseUp">
                    <ui:FontIcon
                        Width="26"
                        Height="26"
                        FontFamily="{StaticResource FluentIconFontFamily}"
                        Foreground="{DynamicResource FloatBarForeground}"
                        Glyph="&#xedd6;" />
                </Border>
            </ikw:SimpleStackPanel>
        </Border>
    </Viewbox>
    <Viewbox
        x:Name="PPTNavigationSidesLeft"
        Width="40"
        Margin="6,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Visibility="Collapsed">
        <Border
            Background="{DynamicResource FloatBarBackground}"
            BorderBrush="{DynamicResource FloatBarBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Opacity="0.4">
            <ikw:SimpleStackPanel Orientation="Vertical">
                <Border
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    CornerRadius="5 5 0 0"
                    MouseDown="Border_MouseDown"
                    MouseUp="GridPPTControlPrevious_MouseUp">
                    <ui:FontIcon
                        Width="26"
