                    <ui:FontIcon
                        Width="26"
                        Height="26"
                        FontFamily="{StaticResource FluentIconFontFamily}"
                        Foreground="{DynamicResource FloatBarForeground}"
                        Glyph="&#xedd7;" />
                </Border>
                <Border
                    Width="40"
                    Height="38"
                    Background="Transparent"
                    MouseDown="Border_MouseDown"
                    MouseUp="PPTNavigationBtn_Click"
                    Visibility="{Binding ElementName=PptNavigationSidesBtn, Path=Visibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="1" />
                        </Grid.RowDefinitions>
                        <Line
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource FloatBarForeground}"
                            StrokeThickness="1"
                            X1="0"
                            X2="25"
                            Y1="0"
                            Y2="0" />
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="9"
                            Foreground="{DynamicResource FloatBarForeground}"
                            Text="{Binding PositionText}" />
                        <Line
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource FloatBarForeground}"
                            StrokeThickness="1"
                            X1="0"
                            X2="25"
                            Y1="0"
                            Y2="0" />
                    </Grid>
                </Border>
                <Border
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    CornerRadius="0 0 5 5"
                    MouseDown="Border_MouseDown"
                    MouseUp="GridPPTControlNext_MouseUp">
                    <ui:FontIcon
                        Width="26"
                        Height="26"
                        FontFamily="{StaticResource FluentIconFontFamily}"
                        Foreground="{DynamicResource FloatBarForeground}"
                        Glyph="&#xedd8;" />
                </Border>
            </ikw:SimpleStackPanel>
        </Border>
    </Viewbox>
    </Grid>
</views:FCViewBase>
