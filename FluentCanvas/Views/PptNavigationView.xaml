        Width="40"
        Margin="0,0,6,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Visibility="Collapsed">
        <Border
            Background="{DynamicResource FloatBarBackground}"
            BorderBrush="{DynamicResource FloatBarBorderBrush}"
            BorderThickness="1"
