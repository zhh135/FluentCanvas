<views:FCViewBase
    x:Class="FluentCanvas.Views.NotificationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:FluentCanvas.Views">
    <Grid
        Name="GridNotifications"
        Margin="0,110"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Visibility="Collapsed">
        <Border
            MaxHeight="200"
            Padding="20,10"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1.5"
            CornerRadius="10"
            Opacity="0.95">
            <TextBlock
                Name="TextBlockNotice"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{Binding Message}" />
        </Border>
    </Grid>
</views:FCViewBase>
